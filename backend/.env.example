# Copy to `backend/.env` and uncomment what you want to override.
# API keys for Claude/Gemini are NOT set here — save them from the app (Agent connectors);
# they go into your OS credential vault (Windows Credential Manager / macOS Keychain).

# ---------- AI models ----------
# INTERVIEW_PREP_CLAUDE_DEFAULT_MODEL=claude-opus-5-5
# INTERVIEW_PREP_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# INTERVIEW_PREP_OLLAMA_BASE_URL=http://localhost:11434
# INTERVIEW_PREP_OLLAMA_DEFAULT_MODEL=llama3.1
# INTERVIEW_PREP_LLM_TIMEOUT_SECONDS=240
# INTERVIEW_PREP_OLLAMA_TIMEOUT_SECONDS=600

# ---------- App ----------
# INTERVIEW_PREP_DATABASE_URL=sqlite:///./data/interview_prep.db
# INTERVIEW_PREP_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
